<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
  Plein écran : padding latéral très large pour centrer le contenu
  Le titre et les boutons restent dans une colonne étroite au centre.
-->
<VBox alignment="CENTER" spacing="24.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.HomeController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      styleClass="root-menu">

    <padding>
        <!-- top/bottom généreux, gauche/droite très large = contenu centré sur grand écran -->
        <Insets top="120.0" bottom="80.0" left="400.0" right="400.0"/>
    </padding>

    <Label text="Bomberman" styleClass="title-main"/>

    <VBox alignment="CENTER" spacing="12.0">
        <Button text="Jouer" onAction="#onPlayClick"
                maxWidth="Infinity" styleClass="button-primary"/>
        <Button text="Paramètres" onAction="#onSettingsClick"
                maxWidth="Infinity" styleClass="button"/>
        <Button text="Quitter" onAction="#onExitClick"
                maxWidth="Infinity" styleClass="button-danger"/>
    </VBox>

    <Label text="v1.0 · SAE S4" styleClass="label-version"/>
</VBox>
