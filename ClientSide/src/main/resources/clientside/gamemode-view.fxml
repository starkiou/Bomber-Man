<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<!--
  Page simple 2 boutons : padding latéral très large, spacing vertical généreux.
-->
<VBox alignment="CENTER" spacing="20.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.LoginController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      style="-fx-background-color: #faf8f5;">

    <padding>
        <Insets top="160.0" bottom="160.0" left="380.0" right="380.0"/>
    </padding>

    <Label text="Mode de jeu" styleClass="title-section"/>

    <Button fx:id="playOfflineButton" text="Jouer hors ligne" onAction="#onPlayOfflineClick"
            maxWidth="Infinity" styleClass="button"/>
    <Button fx:id="playOnlineButton" text="Jouer en ligne" onAction="#onPlayOnlineClick"
            disable="true" maxWidth="Infinity" styleClass="button-online"/>

    <Label fx:id="debugText" text="debug" styleClass="label-debug"/>
</VBox>
