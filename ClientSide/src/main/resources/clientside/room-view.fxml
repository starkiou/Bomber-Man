<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Salle d'attente : la ListView doit prendre tout l'espace vertical disponible.
  Padding latéral large, VBox.vgrow=ALWAYS sur la liste.
-->
<VBox alignment="CENTER" spacing="16.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.RoomViewController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      style="-fx-background-color: #faf8f5;">

    <padding>
        <Insets top="48.0" bottom="36.0" left="160.0" right="160.0"/>
    </padding>

    <Label text="Salle d'attente" styleClass="title-section"/>
    <Label fx:id="roomInfoLabel" text="" styleClass="label-info"/>

    <Separator/>

    <Label text="Joueurs" styleClass="label"/>
    <ListView fx:id="playerListView" VBox.vgrow="ALWAYS" maxWidth="Infinity"/>

    <HBox alignment="CENTER" spacing="16.0">
        <Button fx:id="readyButton" text="Je suis prêt" onAction="#onReadyClick"
                prefWidth="180.0" styleClass="button-success"/>
        <Button fx:id="launchButton" text="Lancer la partie" onAction="#onLaunchClick"
                prefWidth="180.0" styleClass="button-primary"/>
    </HBox>

    <Button text="Quitter la room" onAction="#onLeaveClick" styleClass="button-danger"/>
</VBox>
