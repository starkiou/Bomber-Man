<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.RoomViewController"
      prefHeight="600.0" prefWidth="800.0">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Salle d'attente">
        <font><Font name="System Bold" size="22.0" /></font>
    </Label>

    <Label fx:id="roomInfoLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #555;" />

    <Separator prefWidth="300.0" />

    <Label text="Joueurs :" style="-fx-font-weight: bold;" />
    <ListView fx:id="playerListView" prefHeight="250.0" prefWidth="500.0" />

    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="readyButton" text="Je suis prêt" onAction="#onReadyClick"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="150.0"/>
        <Button fx:id="launchButton" text="Lancer la partie" onAction="#onLaunchClick"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="150.0"/>
    </HBox>

    <Button text="Quitter la room" onAction="#onLeaveClick" style="-fx-text-fill: red;" />
</VBox>
