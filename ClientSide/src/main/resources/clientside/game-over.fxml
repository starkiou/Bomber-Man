<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
  Game over : carte modale centrée, taille fixe, padding interne confortable.
  Le conteneur parent (StackPane dans le controller) gère le centrage.
-->
<VBox alignment="CENTER" spacing="24"
      styleClass="gameover-pane"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.GameOverController"
      stylesheets="@/style.css"
      maxWidth="480" maxHeight="360">

    <padding>
        <Insets top="40" bottom="40" right="60" left="60"/>
    </padding>

    <Label fx:id="resultTitle" text="Vous avez perdu" styleClass="gameover-title"/>

    <VBox spacing="14" alignment="CENTER" styleClass="gameover-stats-pane">
        <padding><Insets top="16" bottom="16" left="24" right="24"/></padding>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Temps survécu :" styleClass="gameover-stat-key" minWidth="150"/>
            <Label fx:id="timeLabel" text="00:00" styleClass="gameover-stat-value"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Kills :" styleClass="gameover-stat-key" minWidth="150"/>
            <Label fx:id="killsLabel" text="0" styleClass="gameover-stat-value"
                   style="-fx-text-fill: #e08080;"/>
        </HBox>
    </VBox>

    <Button text="Retour au menu" onAction="#onReturnMenu"
            maxWidth="Infinity" styleClass="button-secondary"/>
</VBox>
