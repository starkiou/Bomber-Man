<?xml version="1.0" encoding="UTF-8"?>
<!-- Alias de game-config.fxml – conservé pour compatibilité ascendante.
     Pointe vers le même contrôleur avec les mêmes ids. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.GameConfigController"
      prefHeight="600.0" prefWidth="800.0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Configuration de la Partie" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Taille de la carte :"/>
        <ComboBox fx:id="mapSizeBox" prefWidth="180"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Nombre de bots :"/>
        <Spinner fx:id="botCountSpinner" prefWidth="80"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Difficulté :"/>
        <ComboBox fx:id="difficultyBox" prefWidth="150"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Nombre de bombes :"/>
        <Spinner fx:id="bombCountSpinner" prefWidth="80"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Durée (s) :"/>
        <Spinner fx:id="timeSpinner" prefWidth="80"/>
    </HBox>

    <Button text="Lancer la partie" onAction="#onStartButtonClick"
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 16px;"/>

    <Button text="Retour" onAction="#onBackButtonClick"/>
</VBox>