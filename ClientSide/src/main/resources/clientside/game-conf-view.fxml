<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="22.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.GameConfigController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      style="-fx-background-color: #faf8f5;">

    <padding>
        <Insets top="80.0" bottom="80.0" left="360.0" right="360.0"/>
    </padding>

    <Label text="Configuration de la partie" styleClass="title-section"/>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Nombre de joueurs :" styleClass="label" minWidth="180"/>
        <Spinner fx:id="playerCountSpinner" min="2" max="4" initialValue="2"
                 maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Nombre de bots :" styleClass="label" minWidth="180"/>
        <Spinner fx:id="botCountSpinner" min="0" max="3" initialValue="0"
                 maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Difficulté des bots :" styleClass="label" minWidth="180"/>
        <ComboBox fx:id="difficultySelector" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Carte :" styleClass="label" minWidth="180"/>
        <ComboBox fx:id="mapSelector" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox alignment="CENTER" spacing="14">
        <Button text="Retour" onAction="#onBackButtonClick" styleClass="button-secondary"/>
        <Button text="Lancer la partie" onAction="#onStartButtonClick"
                styleClass="button-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

</VBox>
