<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.GameConfController"
      prefHeight="600.0" prefWidth="800.0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Configuration de la Partie" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Nombre de joueurs :"/>
        <Spinner fx:id="playerCountSpinner" min="2" max="4" initialValue="2" prefWidth="80"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Nombre de bots :"/>
        <Spinner fx:id="botCountSpinner" min="0" max="3" initialValue="0" prefWidth="80"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Difficulté des bots :"/>
        <ComboBox fx:id="difficultySelector" prefWidth="150"/>
    </HBox>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Choix de la Map :"/>
        <ComboBox fx:id="mapSelector" prefWidth="150"/>
    </HBox>

    <Button text="Lancer la partie" onAction="#onStartGameClick"
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 16px;"/>

    <Button text="Retour" onAction="#onBackClick"/>

</VBox>