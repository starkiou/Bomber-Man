<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
  Liste de lobbies : la ListView doit occuper tout l'espace restant (vgrow=ALWAYS).
  Padding latéral modéré car la liste a besoin de largeur pour être lisible.
-->
<VBox alignment="CENTER" spacing="16.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.LobbyListController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      style="-fx-background-color: #faf8f5;">

    <padding>
        <Insets top="48.0" bottom="36.0" left="100.0" right="100.0"/>
    </padding>

    <Label text="Parties disponibles" styleClass="title-section"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Rafraîchir" onAction="#onRefreshClick" styleClass="button-secondary"/>
        <Button text="Créer une room" onAction="#onCreateRoomClick" styleClass="button-primary"/>
        <Button fx:id="joinButton" text="Rejoindre" onAction="#onJoinClick" styleClass="button-online"/>
    </HBox>

    <ListView fx:id="roomListView" VBox.vgrow="ALWAYS" maxWidth="Infinity"/>

    <Button text="Retour" onAction="#onBackClick" styleClass="button-secondary" alignment="CENTER_LEFT"/>
</VBox>
