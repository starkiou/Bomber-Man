<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="clientside.controllers.LobbyListController"
      prefHeight="600.0" prefWidth="800.0">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Liste des Parties" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Rafraîchir" onAction="#onRefreshClick"/>
        <Button text="Créer une Room" onAction="#onCreateRoomClick" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
    </HBox>

    <ListView fx:id="roomListView" prefHeight="400.0" prefWidth="600.0" />

    <Button text="Retour" onAction="#onBackClick" style="-fx-text-fill: red;"/>
</VBox>