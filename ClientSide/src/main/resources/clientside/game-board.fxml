<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.GameBoardController">

    <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #333; -fx-padding: 10;">
        <Label fx:id="modeLabel" text="Offline Mode" style="-fx-text-fill: white; -fx-font-weight: bold;"/>

        <HBox spacing="5" alignment="CENTER">
            <Label text="❤️ HP:" style="-fx-text-fill: #ff5555; -fx-font-weight: bold;"/>
            <Label fx:id="hpLabel" text="0" style="-fx-text-fill: white;"/>
        </HBox>

        <HBox spacing="5" alignment="CENTER">
            <Label text="💣 Bombs:" style="-fx-text-fill: #55ff55; -fx-font-weight: bold;"/>
            <Label fx:id="bombsLabel" text="0" style="-fx-text-fill: white;"/>
        </HBox>
    </HBox>

    <ScrollPane fitToHeight="true" fitToWidth="true">
        <GridPane fx:id="gameGrid" alignment="CENTER" style="-fx-background-color: #222;" />
    </ScrollPane>
</VBox>