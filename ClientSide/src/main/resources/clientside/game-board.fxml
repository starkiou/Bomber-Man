<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
  Game board : pas de padding sur le StackPane (le jeu doit remplir l'écran).
  Le HUD est en pleine largeur avec padding interne.
  La grille occupe tout l'espace vertical restant via VBox.vgrow=ALWAYS.
  Padding autour de la grille : 32px pour que la bordure ne colle pas aux bords.
-->
<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="clientside.controllers.GameBoardController"
           stylesheets="@/style.css"
           style="-fx-background-color: #faf8f5;">

    <VBox>

        <!-- HUD — pleine largeur -->
        <HBox alignment="CENTER" spacing="60" styleClass="hud-bar">
            <padding><Insets top="14" bottom="14" left="40" right="40"/></padding>

            <HBox spacing="8" alignment="CENTER">
                <Label text="❤" style="-fx-font-size: 16px; -fx-text-fill: #e08080;"/>
                <Label text="HP" styleClass="label-info"/>
                <Label fx:id="hpLabel" text="3" styleClass="hp-label"/>
            </HBox>

            <!-- Timer centré, prend l'espace restant -->
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER">
                <Label fx:id="timerLabel" text="02:00" styleClass="timer-label"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER">
                <Label text="💣" style="-fx-font-size: 16px;"/>
                <Label text="Bombes" styleClass="label-info"/>
                <Label fx:id="bombsLabel" text="1/1" styleClass="bombs-label"/>
            </HBox>

            <Label fx:id="modeLabel" text="HORS LIGNE" styleClass="mode-label"/>
        </HBox>

        <!-- Grille — occupe tout l'espace vertical -->
        <VBox VBox.vgrow="ALWAYS" alignment="CENTER">
            <padding><Insets top="32" bottom="32" left="40" right="40"/></padding>
            <ScrollPane fitToHeight="true" fitToWidth="true"
                        VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <GridPane fx:id="gameGrid" alignment="CENTER" styleClass="game-grid"/>
            </ScrollPane>
        </VBox>

    </VBox>

</StackPane>
