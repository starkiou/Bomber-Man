<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Formulaire de création de room : contenu compact, très centré.
  Padding latéral très large.
-->
<VBox alignment="CENTER" spacing="16.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.RoomCreationConfigController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      style="-fx-background-color: #faf8f5;">

    <padding>
        <Insets top="70.0" bottom="70.0" left="380.0" right="380.0"/>
    </padding>

    <Label text="Créer une room" styleClass="title-section"/>

    <Separator/>

    <Label text="Nom de la room" styleClass="label"/>
    <TextField fx:id="roomNameField" promptText="Ma Room" maxWidth="Infinity"/>

    <Label text="Taille de la carte" styleClass="label"/>
    <ComboBox fx:id="mapSizeBox" maxWidth="Infinity"/>

    <Label text="Nombre d'ennemis (IA)" styleClass="label"/>
    <Spinner fx:id="botCountSpinner" maxWidth="Infinity"/>

    <Label text="Niveau de difficulté" styleClass="label"/>
    <ComboBox fx:id="difficultyBox" maxWidth="Infinity"/>

    <Label fx:id="errorLabel" styleClass="label-error" text=""/>

    <Separator/>

    <HBox alignment="CENTER" spacing="14.0">
        <Button onAction="#onBackClick" text="Annuler" styleClass="button-secondary"/>
        <Button onAction="#onCreateClick" text="Créer la room"
                styleClass="button-success" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
</VBox>
