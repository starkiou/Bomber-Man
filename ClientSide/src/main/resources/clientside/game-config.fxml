<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="clientside.controllers.GameConfigController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Configuration de la Partie Locale">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>
    
    <Separator prefWidth="200.0" />

    <Label text="Taille de la carte :" />
    <ComboBox fx:id="mapSizeBox" prefWidth="150.0" />

    <Label text="Nombre d'adversaires (IA) :" />
    <Spinner fx:id="botCountSpinner" prefWidth="150.0" />

    <Label text="Niveau de difficulté :" />
    <ComboBox fx:id="difficultyBox" prefWidth="150.0" />

    <Separator prefWidth="200.0" />

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBackButtonClick" text="Retour" />
        <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStartButtonClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="▶ Lancer la partie" />
    </HBox>
</VBox>