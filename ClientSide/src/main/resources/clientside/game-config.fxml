<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Formulaire de config : contenu compact centré.
  Padding latéral très large, spacing vertical aéré.
-->
<VBox alignment="CENTER" spacing="22.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.GameConfigController"
      maxWidth="Infinity" maxHeight="Infinity"
      stylesheets="@/style.css"
      style="-fx-background-color: #faf8f5;">

    <padding>
        <Insets top="80.0" bottom="80.0" left="360.0" right="360.0"/>
    </padding>

    <Label text="Configuration" styleClass="title-section"/>

    <Separator/>

    <HBox alignment="CENTER" spacing="32">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Taille de la carte" styleClass="label"/>
            <ComboBox fx:id="mapSizeBox" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Adversaires (IA)" styleClass="label"/>
            <Spinner fx:id="botCountSpinner" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER" spacing="32">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Bombes initiales" styleClass="label"/>
            <Spinner fx:id="bombCountSpinner" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Durée (sec)" styleClass="label"/>
            <Spinner fx:id="timeSpinner" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox spacing="8">
        <Label text="Difficulté" styleClass="label"/>
        <ComboBox fx:id="difficultyBox" maxWidth="Infinity"/>
    </VBox>

    <Separator/>

    <HBox alignment="CENTER" spacing="16.0">
        <Button fx:id="backButton" onAction="#onBackButtonClick" text="Retour" styleClass="button-secondary"/>
        <Button fx:id="startButton" onAction="#onStartButtonClick" text="Lancer la partie"
                styleClass="button-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
</VBox>
