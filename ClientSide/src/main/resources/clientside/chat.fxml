<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefHeight="400.0" prefWidth="300.0"
      style="-fx-background-color: #1a1a1a; -fx-padding: 10;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clientside.controllers.ChatController">

    <Label text="ROOM CHAT" style="-fx-text-fill: #555555; -fx-font-weight: bold;"/>

    <TextArea fx:id="chatDisplay" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
              style="-fx-control-inner-background: #2b2b2b; -fx-text-fill: #00ff00; -fx-font-family: 'Consolas'; -fx-border-color: #333333;"/>

    <HBox spacing="5">
        <TextField fx:id="inputField" HBox.hgrow="ALWAYS" onAction="#onSendMessage"
                   promptText="Écrire..."
                   style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #777777;"/>

        <Button text="OK" onAction="#onSendMessage"
                style="-fx-background-color: #444444; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>